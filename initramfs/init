#!/bin/sh
# olpc-boy initramfs /init  (busybox ash, static busybox, no device nodes
# shipped: everything comes from devtmpfs).
#
# Flow:
#   1. mount proc/sys/devtmpfs, grab the console
#   2. find + mount the FAT log partition (LABEL=OLPCLOG), create the next
#      logs/boot-NNNN/ directory, start the kmsg copier
#   3. find + mount the ext4 root (LABEL=OLPCROOT or olpcboy.root=)
#   4. point the new root at the boot dir, move mounts, exec switch_root
# NAND boot (kernel flag olpcboy.nand, set by the olpc.fth stored on the internal NAND): there is
# no log partition and no label to look for.  The external initrd of that olpc.fth carries
# cafe_nand.ko; steps 2-3 become: load the driver (allow_bbt_write=0), verify the MTD layout,
# mount mtd0 (JFFS2) as root, keep boot logs in /data/olpclog/logs/boot-NNNN on that root, and
# hand over with /data/olpclog bound on /mnt/olpclog and /data bound on /mnt/internal.
# On failure: big message on the console, diagnostics to the log partition,
# keep retrying forever; a getty on tty2 is available for a USB keyboard.
# Never use `set -e` here: a failed probe must not abort logging.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

LOGLABEL=OLPCLOG
ROOTLABEL=OLPCROOT
WAIT_SECS=20

CON=/dev/console
LOGMNT=/log
NEWROOT=/newroot
BOOTNAME=""     # e.g. boot-0007
BOOTDIR=""      # absolute path of the boot dir (log partition or tmpfs)
HAVE_LOG=0
LOGDEV=""
ROOTDEV=""
KMSG_PID=""

# ---------------------------------------------------------------- basics
mkdir -p /proc /sys /dev /run /tmp /log /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o mode=0755 tmpfs /run
mkdir -p /run/olpcboy

# grab the console (kernel could not open one: no /dev/console in the cpio)
if [ -c "$CON" ]; then
	exec <"$CON" >"$CON" 2>&1
fi
# console must never blank/power down: nobody can press a key to wake it
printf '\033[9;0]\033[14;0]' 2>/dev/null

# Black on white: the display boots in DCON mono/reflective mode, where a white
# background is the readable one.  Swap palette entries 0<->7 (and 8/15) in the
# VT defaults so every console gets it, then reset tty1's palette to them.
P=/sys/module/vt/parameters
if [ -w $P/default_red ]; then
	echo 0xff,0xaa,0x00,0xaa,0x00,0xaa,0x00,0x00,0xaa,0xff,0x55,0xff,0x55,0xff,0x55,0x00 >$P/default_red
	echo 0xff,0x00,0xaa,0x55,0x00,0x00,0xaa,0x00,0xaa,0x55,0xff,0xff,0x55,0x55,0xff,0x00 >$P/default_grn
	echo 0xff,0x00,0x00,0x00,0xaa,0xaa,0xaa,0x00,0xaa,0x55,0x55,0x55,0xff,0xff,0xff,0x00 >$P/default_blu
	[ -c /dev/tty1 ] && printf '\033]R' >/dev/tty1 2>/dev/null
fi

# boot splash (skipped by olpcboy.verbose); the console stays in graphics mode so nothing scribbles on it
olpc-splash init 5 "Starting kernel"
grep -q olpcboy.verbose /proc/cmdline && dmesg -n 7   # verbose: kernel messages on screen again (loglevel=1 hides them)

CMDLINE=$(cat /proc/cmdline)
NANDMODE=0
SIM=0
for w in $CMDLINE; do
	case "$w" in
	olpcboy.nand) NANDMODE=1 ;;
	olpcboy.nandsim) SIM=1 ;;
	esac
done
NAND_KEEP=20                     # boot log directories kept on the NAND

cmdline_get() {   # cmdline_get key  -> value of key=value (empty if absent)
	for w in $CMDLINE; do
		case "$w" in
		"$1"=*) echo "${w#*=}"; return 0 ;;
		esac
	done
	return 1
}

uptime_s() { cut -d' ' -f1 /proc/uptime; }
# whole seconds of uptime, no fork.  Waits are measured with it, not by counting
# `sleep` calls: on the first real boot sleep returned at once.
now_s() { read -r NOW _ </proc/uptime; NOW=${NOW%.*}; }

# tl: timeline entry, to tmpfs and (if available) to the boot dir
tl() {
	echo "$(uptime_s) initramfs: $*" >>/run/olpcboy/timeline.log
	[ -n "$BOOTDIR" ] && echo "$(uptime_s) initramfs: $*" >>"$BOOTDIR/timeline.log"
}

say() { echo "[olpc-boy] $*"; tl "$*"; }

# ---------------------------------------------------------------- helpers
# NAND policy: busybox findfs/blkid/mount-by-LABEL open EVERY entry of
# /proc/partitions, mtdblock0 included, and opening the NAND block device is
# what the first real boot logged five times.  So devices are enumerated here
# and only sd*/mmcblk*/vd*/hd*/nvme* are ever probed.
safe_devs() {
	while read -r _ma _mi _bl _nm; do
		case "$_nm" in
		sd[a-z]*|mmcblk[0-9]*|vd[a-z]*|hd[a-z]*|nvme[0-9]*) echo "/dev/$_nm" ;;
		esac
	done </proc/partitions
}

safe_blkid() {   # blkid over the safe devices only
	for _d in $(safe_devs); do
		[ -b "$_d" ] && blkid "$_d" 2>/dev/null
	done
}

# find_key KEY VALUE  (KEY = LABEL or UUID) -> device path on stdout
find_key() {
	for _d in $(safe_devs); do
		[ -b "$_d" ] || continue
		_o="$(blkid "$_d" 2>/dev/null) "
		case "$_o" in
		*" $1=\"$2\" "*) echo "$_d"; return 0 ;;
		esac
	done
	return 1
}

find_label() {   # find_label LABEL -> device path on stdout
	find_key LABEL "$1"
}

# wait_label LABEL SECS -> prints device, returns 0/1
wait_label() {
	now_s; _end=$((NOW + $2))
	while :; do
		_d=$(find_label "$1")
		if [ -n "$_d" ] && [ -b "$_d" ]; then echo "$_d"; return 0; fi
		now_s
		[ "$NOW" -ge "$_end" ] && return 1
		sleep 1
	done
}

num_strip() { _n=$(echo "$1" | sed 's/^0*//'); echo "${_n:-0}"; }

# ---------------------------------------------------------------- log part
mount_log() {
	LOGDEV=$(wait_label "$LOGLABEL" "$WAIT_SECS")
	if [ -z "$LOGDEV" ]; then
		say "log partition LABEL=$LOGLABEL NOT FOUND after ${WAIT_SECS}s"
		return 1
	fi
	say "log partition is $LOGDEV"
	# flush: vfat writes data out aggressively; we also run a 1s sync loop
	mount -t vfat -o rw,noatime,flush "$LOGDEV" "$LOGMNT" 2>/run/olpcboy/mount_log.err \
		|| mount -o rw,noatime "$LOGDEV" "$LOGMNT" 2>>/run/olpcboy/mount_log.err
	rc=$?
	if [ $rc -ne 0 ]; then
		say "mounting $LOGDEV failed rc=$rc: $(cat /run/olpcboy/mount_log.err)"
		return 1
	fi
	return 0
}

new_boot_dir() {
	mkdir -p "$LOGMNT/logs"
	# previous boot = highest existing boot-NNNN (before we create ours)
	PREV=$(ls -d "$LOGMNT"/logs/boot-[0-9]* 2>/dev/null | sort | tail -1)
	c=""
	[ -f "$LOGMNT/logs/counter" ] && c=$(head -n1 "$LOGMNT/logs/counter" | tr -dc '0-9')
	n=$(num_strip "$c")
	if [ -n "$PREV" ]; then      # counter lost/behind: trust the directory list
		pn=$(num_strip "${PREV##*boot-}")
		[ "$pn" -gt "$n" ] && n=$pn
	fi
	n=$((n + 1))
	while :; do
		BOOTNAME=$(printf 'boot-%04d' "$n")
		[ -e "$LOGMNT/logs/$BOOTNAME" ] || break
		n=$((n + 1))
	done
	mkdir -p "$LOGMNT/logs/$BOOTNAME" || return 1
	echo "$n" >"$LOGMNT/logs/counter"
	BOOTDIR="$LOGMNT/logs/$BOOTNAME"
	: >"$BOOTDIR/STARTED"
	echo "$(uptime_s)" >"$BOOTDIR/STARTED"
	# the new root finds this through logs/current as well as /var/log/olpc-current
	echo "$BOOTNAME" >"$LOGMNT/logs/current"
	cat /run/olpcboy/timeline.log >>"$BOOTDIR/timeline.log" 2>/dev/null
	echo "$CMDLINE" >"$BOOTDIR/cmdline.txt"

	if [ -n "$PREV" ] && [ -f "$PREV/STARTED" ] && [ ! -f "$PREV/REACHED_USERSPACE_OK" ]; then
		echo "previous boot ${PREV##*/} has STARTED but no REACHED_USERSPACE_OK" \
			>"$BOOTDIR/PREVIOUS_BOOT_INCOMPLETE"
		say "WARNING: previous boot ${PREV##*/} did not reach userspace"
	fi
	sync
	say "boot dir is $BOOTNAME"
	return 0
}

# kmsg copier: ONE long-lived `cat` so it keeps working after switch_root
# (the initramfs is deleted then; a shell loop could not exec anything).
start_kmsg_copier() {
	if [ -c /dev/kmsg ]; then
		cat /dev/kmsg >>"$1" 2>/dev/null &
		KMSG_PID=$!
		echo "$KMSG_PID" >/run/olpcboy/kmsg.pid
	else
		say "no /dev/kmsg (CONFIG_DEVKMSG?) - copier not started"
	fi
}

# 3 s sync loop, only lives until switch_root (olpclog service takes over)
start_syncer() {
	( while :; do sync; sleep 3; done ) &
	SYNC_PID=$!
}

# ---------------------------------------------------------------- failure
# Print a big message, dump diagnostics, keep tty2 shell for a USB keyboard.
SH_STARTED=0
spawn_tty2_shell() {
	[ "$SH_STARTED" = 1 ] && return
	SH_STARTED=1
	[ -c /dev/tty2 ] && getty -n -l /bin/sh 38400 tty2 </dev/null >/dev/null 2>&1 &
}

dump_diag() {   # dump_diag file
	{
		echo "== uptime $(uptime_s)"
		echo "== cmdline: $CMDLINE"
		echo "== /proc/partitions"; cat /proc/partitions
		echo "== blkid (non-MTD devices only)"; safe_blkid
		echo "== mounts"; cat /proc/mounts
		echo "== /proc/filesystems"; cat /proc/filesystems
		echo "== dmesg tail"; dmesg | tail -n 120
	} >"$1" 2>&1
}

fail() {   # fail "reason line 1" ["reason line 2"]
	[ -f /run/olpcboy/splash ] && olpc-splash text   # text console back so the message below is visible
	spawn_tty2_shell
	{
		echo
		echo "########################################################"
		echo "#                                                      #"
		echo "#   OLPC-BOY BOOT FAILURE                              #"
		echo "#                                                      #"
		echo "########################################################"
		for l in "$@"; do echo "  $l"; done
		echo
		echo "  Partitions seen by the kernel:"
		sed -n '3,$p' /proc/partitions 2>/dev/null | head -n 8
		echo
		if [ "$NANDMODE" = 1 ]; then
			echo "  The internal NAND did not boot.  Power off and boot from a USB stick"
			echo "  (the stick wins over the NAND); the README explains the way back."
		else
			echo "  Still retrying every 10 s.  No keyboard needed."
			echo "  Power off, plug the USB stick in a PC, read logs/."
		fi
	} >"$CON" 2>&1
	if [ "$HAVE_LOG" = 1 ] && [ -n "$BOOTDIR" ]; then
		dump_diag "$BOOTDIR/initramfs-failure.txt"
		echo "$*" >"$BOOTDIR/INITRAMFS_FAILURE"
		sync
	elif [ "$NANDMODE" = 1 ]; then
		dump_diag /run/olpcboy/initramfs-failure.txt
	fi
}

# ---------------------------------------------------------------- root
want_root() {   # sets ROOTDEV from olpcboy.root= or LABEL=OLPCROOT; $1 = wait secs
	spec=$(cmdline_get olpcboy.root)
	[ -z "$spec" ] && spec="LABEL=$ROOTLABEL"
	now_s; _end=$((NOW + $1))
	while :; do
		case "$spec" in
		LABEL=*|UUID=*) ROOTDEV=$(find_key "${spec%%=*}" "${spec#*=}") ;;
		PARTUUID=*) ROOTDEV="" ;;     # would need findfs (probes mtd): unsupported
		/dev/*) ROOTDEV=$spec ;;
		*) ROOTDEV=$(find_label "$spec") ;;
		esac
		[ -n "$ROOTDEV" ] && [ -b "$ROOTDEV" ] && return 0
		now_s
		[ "$NOW" -ge "$_end" ] && return 1
		sleep 1
	done
}

mount_root() {
	rm -f /run/olpcboy/mount_root.err
	mount -t ext4 -o rw,noatime "$ROOTDEV" "$NEWROOT" 2>/run/olpcboy/mount_root.err \
		|| mount -o rw,noatime "$ROOTDEV" "$NEWROOT" 2>>/run/olpcboy/mount_root.err
}

# Prepare the new root, then hand over.  Returns only on failure.
handover() {
	mkdir -p "$NEWROOT/run" "$NEWROOT/dev" "$NEWROOT/proc" "$NEWROOT/sys" \
		"$NEWROOT/mnt/olpclog" "$NEWROOT/var/log" 2>/dev/null
	[ "$NANDMODE" = 1 ] && mkdir -p "$NEWROOT/mnt/internal" "$NEWROOT/data/roms" "$NEWROOT/data/covers" 2>/dev/null

	if [ "$HAVE_LOG" = 1 ]; then
		TARGET=/mnt/olpclog/logs/$BOOTNAME
	else
		# no log partition: log to the root fs (persistent, still readable later)
		TARGET=/var/log/olpc-nolog-boot
		mkdir -p "$NEWROOT$TARGET"
		cp /run/olpcboy/timeline.log "$NEWROOT$TARGET/" 2>/dev/null
		echo "$CMDLINE" >"$NEWROOT$TARGET/cmdline.txt"
		echo "log partition missing" >"$NEWROOT$TARGET/NO_LOG_PARTITION"
		BOOTNAME=nolog
	fi
	# /var/log/olpc-current -> boot dir; rc.conf / syslog / scripts use this path
	rm -rf "$NEWROOT/var/log/olpc-current"
	ln -s "$TARGET" "$NEWROOT/var/log/olpc-current"
	mkdir -p "$NEWROOT/run/olpcboy"
	echo "$TARGET" >/run/olpcboy/bootdir
	echo "$HAVE_LOG" >/run/olpcboy/haslog
	[ -n "$KMSG_PID" ] && echo "$KMSG_PID" >/run/olpcboy/kmsg.pid
	cp /run/olpcboy/timeline.log "$NEWROOT/run/olpcboy/" 2>/dev/null

	# fstab with explicit devices: `mount LABEL=...` / remount at boot would
	# probe every block device (mtdblock included).  The file is rewritten each boot.
	{
		if [ "$NANDMODE" = 1 ]; then
			echo "$ROOTDEV	/	jffs2	rw,noatime	0 0"
		else
			echo "$ROOTDEV	/	ext4	rw,noatime	0 0"
			[ "$HAVE_LOG" = 1 ] && echo "$LOGDEV	/mnt/olpclog	vfat	rw,noatime,flush,noauto	0 0"
		fi
		echo "tmpfs	/tmp	tmpfs	nosuid,nodev,size=32m	0 0"
	} >"$NEWROOT/etc/fstab"

	tl "switching root (root=$ROOTDEV)"
	[ "$HAVE_LOG" = 1 ] && { cp /proc/mounts "$BOOTDIR/initramfs-mounts.txt"; sync; }
	[ -n "$SYNC_PID" ] && kill "$SYNC_PID" 2>/dev/null

	# order matters: log partition first (needs the mountpoint on the new root)
	if [ "$NANDMODE" = 1 ]; then
		# the stick's role is played by directories of the JFFS2 root: /mnt/olpclog (logs, WIFI.CFG,
		# settings) and /mnt/internal (the ROM tree); both show up in /proc/mounts
		mount --bind "$NEWROOT/data/olpclog" "$NEWROOT/mnt/olpclog" \
			&& mount --bind "$NEWROOT/data" "$NEWROOT/mnt/internal" \
			|| tl "WARNING: bind mounts of /data failed"
		echo 1 >/run/olpcboy/nand
	elif [ "$HAVE_LOG" = 1 ]; then
		mount --move "$LOGMNT" "$NEWROOT/mnt/olpclog"
	fi
	mount --move /dev "$NEWROOT/dev"
	mount --move /proc "$NEWROOT/proc"
	mount --move /sys "$NEWROOT/sys"
	mount --move /run "$NEWROOT/run"

	INIT=$(cmdline_get init)
	[ -z "$INIT" ] && INIT=/sbin/init
	exec switch_root "$NEWROOT" "$INIT"
	# only reached if exec failed; mounts are already moved, so complain
	echo "switch_root exec failed" >"$CON"
	return 1
}

# ---------------------------------------------------------------- NAND boot (olpcboy.nand)
# Geometry of the layout the olpc.fth asks for (cmdline mtdparts): mtd0 "olpcboy" = every erase
# block below the bad block tables (writeable, the JFFS2 root), mtd1 "bbt" = the 4 table blocks (read-only).
if [ "$SIM" = 1 ]; then          # nandsim, 256 MiB: same geometry, scaled (QEMU tests)
	NAND_ERASE=131072 NAND_WRITE=2048 NAND_P0=$((2044 * 131072)) NAND_P1=$((4 * 131072))
else                             # XO-1 CaFe NAND, 1 GiB: blocks 0..8187 + 8188..8191
	NAND_ERASE=131072 NAND_WRITE=2048 NAND_P0=$((8188 * 131072)) NAND_P1=$((4 * 131072))
fi

nand_attr() { read -r _na <"/sys/class/mtd/mtd$1/$2" 2>/dev/null && echo "$_na" || echo "?"; }

nand_die() {   # nand_die REASON...   never returns: the message stays, nothing was written
	fail "$@"
	while :; do sleep 10; done
}

# the layout must be exactly the expected one before the root is mounted read-write
nand_layout_check() {
	_err=""
	_cnt=0
	for _d in /sys/class/mtd/mtd*; do
		_b=${_d##*/}
		case ${_b#mtd} in ''|*[!0-9]*) continue ;; esac
		_cnt=$((_cnt + 1))
	done
	[ "$_cnt" = 2 ] || _err="$_err $_cnt mtd partitions instead of 2;"
	[ "$(nand_attr 0 name)" = olpcboy ] || _err="$_err mtd0 name=$(nand_attr 0 name);"
	[ "$(nand_attr 1 name)" = bbt ] || _err="$_err mtd1 name=$(nand_attr 1 name);"
	[ "$(nand_attr 0 size)" = "$NAND_P0" ] || _err="$_err mtd0 size=$(nand_attr 0 size) (want $NAND_P0);"
	[ "$(nand_attr 1 size)" = "$NAND_P1" ] || _err="$_err mtd1 size=$(nand_attr 1 size) (want $NAND_P1);"
	[ "$(nand_attr 0 offset)" = 0 ] || _err="$_err mtd0 offset=$(nand_attr 0 offset);"
	[ "$(nand_attr 1 offset)" = "$NAND_P0" ] || _err="$_err mtd1 offset=$(nand_attr 1 offset);"
	for _n in 0 1; do
		[ "$(nand_attr $_n type)" = nand ] || _err="$_err mtd$_n type=$(nand_attr $_n type);"
		[ "$(nand_attr $_n erasesize)" = "$NAND_ERASE" ] || _err="$_err mtd$_n erasesize=$(nand_attr $_n erasesize);"
		[ "$(nand_attr $_n writesize)" = "$NAND_WRITE" ] || _err="$_err mtd$_n writesize=$(nand_attr $_n writesize);"
	done
	_f=$(nand_attr 0 flags); _g=$(nand_attr 1 flags)
	case $_f$_g in *'?'*) _err="$_err flags unreadable;" ;; *)
		[ $((_f & 0x400)) -ne 0 ] || _err="$_err mtd0 is not writeable;"
		[ $((_g & 0x400)) -eq 0 ] || _err="$_err mtd1 (bad block tables) IS WRITEABLE;" ;;
	esac
	if [ "$SIM" != 1 ]; then
		read -r _p </sys/module/cafe_nand/parameters/allow_bbt_write 2>/dev/null
		[ "$_p" = 0 ] || _err="$_err allow_bbt_write='$_p';"
	fi
	[ -z "$_err" ] && return 0
	NAND_LAYOUT_ERR=$_err
	return 1
}

nand_prune() {   # keep the newest NAND_KEEP boot directories
	_n=$(ls -d "$LOGMNT"/logs/boot-[0-9]* 2>/dev/null | wc -l)
	[ "$_n" -gt "$NAND_KEEP" ] || return 0
	ls -d "$LOGMNT"/logs/boot-[0-9]* | sort | head -n $((_n - NAND_KEEP)) | while read -r _old; do rm -rf "$_old"; done
}

nand_main() {
	olpc-splash progress 15 "Starting internal storage"
	if [ "$SIM" = 1 ]; then _ko=/nandmods/nandsim.ko; _args="id_bytes=0xec,0xda,0x10,0x95"
	else _ko=/nandmods/cafe_nand.ko; _args="allow_bbt_write=0"; fi
	[ -f "$_ko" ] || nand_die "NAND driver module missing from the initrd" "$_ko"
	say "NAND boot: loading $_ko $_args"
	insmod "$_ko" $_args 2>/run/olpcboy/insmod.err \
		|| nand_die "Cannot load the NAND driver" "$(cat /run/olpcboy/insmod.err)"
	now_s; _end=$((NOW + 30))
	while ! { [ -d /sys/class/mtd/mtd1 ] && [ -b /dev/mtdblock0 ]; }; do
		now_s
		[ "$NOW" -ge "$_end" ] && nand_die "No NAND found" "The driver loaded but mtd0/mtd1 did not appear." "$(dmesg | tail -n 3)"
		sleep 1
	done
	if [ "$SIM" = 1 ]; then
		# QEMU only: write the NAND image of the installer into the fresh simulated NAND
		_fill=""
		for w in $CMDLINE; do case "$w" in olpcboy.nandsimfill=*) _fill=${w#*=} ;; esac; done
		if [ -n "$_fill" ]; then
			_dev=${_fill%%:*}; _sz=${_fill#*:}
			now_s; _end=$((NOW + 30))
			while [ ! -b "/dev/$_dev" ]; do now_s; [ "$NOW" -ge "$_end" ] && nand_die "sim fill device $_dev missing"; sleep 1; done
			say "sim: writing $_sz bytes from $_dev into the simulated NAND"
			head -c "$_sz" "/dev/$_dev" | nandwrite -p /dev/mtd0 - >/run/olpcboy/simfill.out 2>&1 \
				|| nand_die "sim fill failed" "$(cat /run/olpcboy/simfill.out)"
		fi
	fi
	nand_layout_check || nand_die "The NAND layout is not the expected one" "$NAND_LAYOUT_ERR" "Refusing to mount it read-write."
	say "NAND layout ok (mtd0 olpcboy rw, mtd1 bbt ro)"
	olpc-splash progress 30 "Mounting system"
	ROOTDEV=/dev/mtdblock0
	rm -f /run/olpcboy/mount_root.err
	mount -t jffs2 -o rw,noatime "$ROOTDEV" "$NEWROOT" 2>/run/olpcboy/mount_root.err \
		|| nand_die "Cannot mount the NAND root (JFFS2)" "$(cat /run/olpcboy/mount_root.err)"
	[ -x "$NEWROOT/sbin/init" ] || nand_die "The NAND root has no /sbin/init" "Is olpc-boy installed on it?"
	say "root mounted (jffs2 on $ROOTDEV)"
	LOGMNT=$NEWROOT/data/olpclog
	mkdir -p "$LOGMNT"
	if new_boot_dir; then
		HAVE_LOG=1
		nand_prune
		start_kmsg_copier "$BOOTDIR/kmsg.log"
		[ "$SIM" = 1 ] && [ -c /dev/ttyS0 ] && { tail -f "$BOOTDIR/timeline.log" >/dev/ttyS0 2>&1 & }
	else
		say "cannot create the boot dir on the NAND"
		start_kmsg_copier /run/olpcboy/kmsg.log
		spawn_tty2_shell
	fi
	handover   # does not return on success
	nand_die "switch_root handover failed" "root=$ROOTDEV"
}

# ================================================================= main
say "olpc-boy initramfs starting, cmdline: $CMDLINE"

[ "$NANDMODE" = 1 ] && nand_main      # never returns

olpc-splash progress 15 "Mounting storage"
if mount_log; then
	HAVE_LOG=1
	if new_boot_dir; then
		start_kmsg_copier "$BOOTDIR/kmsg.log"
		start_syncer
	else
		say "cannot create boot dir on log partition"
		HAVE_LOG=0
		BOOTDIR=""
	fi
fi
if [ "$HAVE_LOG" = 0 ]; then
	# continue without the stick: kmsg goes to tmpfs (/run survives the move)
	start_kmsg_copier /run/olpcboy/kmsg.log
	spawn_tty2_shell
	echo "NO LOG PARTITION - logging to tmpfs only" >"$CON"
fi

olpc-splash progress 30 "Mounting system"
if want_root "$WAIT_SECS"; then :; else
	fail "Root filesystem not found (wanted: $(cmdline_get olpcboy.root || echo LABEL=$ROOTLABEL))"
fi

while :; do
	if [ -n "$ROOTDEV" ] && [ -b "$ROOTDEV" ]; then
		say "root device is $ROOTDEV"
		if mount_root; then
			say "root mounted"
			handover   # does not return on success
			fail "switch_root handover failed" "root=$ROOTDEV"
		else
			e=$(cat /run/olpcboy/mount_root.err 2>/dev/null)
			fail "Cannot mount root $ROOTDEV" "$e"
		fi
	fi
	sleep 10
	want_root 1
done
