# root is mounted by the initramfs (LABEL=OLPCROOT or olpcboy.root=)
LABEL=OLPCROOT	/		ext4	rw,noatime	0 0
# already mounted (and moved here) by the initramfs; noauto so localmount
# never fights over it.  `mount /mnt/olpclog` works as a fallback.
LABEL=OLPCLOG	/mnt/olpclog	vfat	rw,noatime,flush,noauto	0 0
tmpfs		/tmp		tmpfs	nosuid,nodev,size=32m	0 0
