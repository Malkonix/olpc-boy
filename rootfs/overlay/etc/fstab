# The initramfs REWRITES this file at every boot with the real devices it
# mounted (device nodes instead of LABEL=: `mount LABEL=...` probes every block
# device, mtdblock included).  This copy is only the fallback for a root that
# was not entered through the initramfs.
LABEL=OLPCROOT	/		ext4	rw,noatime	0 0
LABEL=OLPCLOG	/mnt/olpclog	vfat	rw,noatime,flush,noauto	0 0
tmpfs		/tmp		tmpfs	nosuid,nodev,size=32m	0 0
