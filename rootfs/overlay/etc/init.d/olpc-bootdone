#!/sbin/openrc-run
# Last service of the default runlevel: marks the boot as complete and starts
# the (background, nice 19) hardware inventory.

description="olpc-boy boot-complete marker"

depend() {
	need olpclog
	after *
}

start() {
	ebegin "Writing REACHED_USERSPACE_OK"
	/usr/local/sbin/olpc-bootdone
	eend $?
}
stop() { return 0; }
