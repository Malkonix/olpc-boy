#!/sbin/openrc-run
# Early logging service: finds the boot dir, sets up core dumps, keeps the
# log partition synced.  Robust if /mnt/olpclog is not mounted (the boot dir
# is then a directory on the root fs, see common.sh).

description="olpc-boy boot logging (boot dir, core dumps, sync loop)"

depend() {
	after sysfs procfs devfs
	before modules hwdrivers mdev syslog bootmisc
}

start() {
	. /usr/libexec/olpcboy/common.sh
	/usr/local/sbin/olpc-splash progress 45 "Loading drivers"
	ebegin "olpclog: boot dir $BOOTDIR"
	mkdir -p "$BOOTDIR" /run/olpcboy
	echo "$BOOTDIR" >/run/olpcboy/bootdir
	tl "olpclog start (boot dir $BOOTDIR)"

	# make sure the logging fs is writable; if the initramfs could not mount
	# it, try once more on the explicit device (never `mount LABEL=`: that
	# would probe every block device, mtdblock included).  Never fatal.
	# (NAND boot: /mnt/olpclog is a bind of /data/olpclog made by the initramfs; no stick is involved)
	if ! cmdline_has olpcboy.nand && ! grep -q ' /mnt/olpclog ' /proc/mounts; then
		tl "WARNING: /mnt/olpclog not mounted, retrying"
		for d in $(olpc_blockdevs); do
			case "$(blkid "$d" 2>/dev/null)" in
			*'LABEL="OLPCLOG"'*)
				mount -t vfat -o rw,noatime,flush "$d" /mnt/olpclog 2>>"$BOOTDIR/olpclog.err"
				break ;;
			esac
		done
	fi

	# core dumps into the boot dir: kernel.core_pattern, size-limited by the
	# rc_ulimit in rc.conf (services) and ulimit -c in /etc/profile (shells)
	echo "$BOOTDIR/core.%e.%p" >/proc/sys/kernel/core_pattern 2>/dev/null
	echo 0 >/proc/sys/kernel/core_uses_pid 2>/dev/null

	cat /proc/uptime >"$BOOTDIR/uptime.at-olpclog" 2>/dev/null
	start-stop-daemon --start --background --make-pidfile \
		--pidfile /run/olpcboy/syncloop.pid \
		--exec /usr/libexec/olpcboy/syncloop
	eend 0
}

stop() {
	. /usr/libexec/olpcboy/common.sh
	ebegin "olpclog: final sync"
	tl "olpclog stop (shutdown)"
	start-stop-daemon --stop --quiet --pidfile /run/olpcboy/syncloop.pid
	sync
	eend 0
}
