#!/sbin/openrc-run
# One-shot hardware inventory into the boot dir (runs in the background so
# a slow probe cannot delay or block boot).

description="olpc-boy one-shot hardware inventory"

depend() {
	need olpclog
	after mdev hwdrivers modules bootmisc
}

start() {
	ebegin "Starting hardware inventory (background)"
	start-stop-daemon --start --background --quiet \
		--exec /usr/local/sbin/olpc-inventory
	eend 0
}
stop() { return 0; }
