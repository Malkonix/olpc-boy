#!/bin/sh
# Software boot watchdog: runs in the background (started by the olpc-watchdog
# service).  If REACHED_USERSPACE_OK does not exist OLPC_WATCHDOG_SECS (default
# 90) after the initramfs started, dump diagnostics.  It never reboots and
# never touches /dev/watchdog.
# The deadline is measured from the first timeline entry (the initramfs), not
# from absolute uptime: the kernel alone takes ~30 s on the XO-1.
. /usr/libexec/olpcboy/common.sh
WAIT=${OLPC_WATCHDOG_SECS:-90}
BASE=$(head -n1 "$BOOTDIR/timeline.log" 2>/dev/null | cut -d. -f1)
case "$BASE" in ''|*[!0-9]*) BASE=0 ;; esac
LIMIT=$((BASE + WAIT))
# Poll against absolute uptime instead of one long sleep: OpenRC may restart this
# service (pidfile lost when /run is migrated) and a killed sleep must not look
# like a timeout.
while :; do
	[ -e "$BOOTDIR/REACHED_USERSPACE_OK" ] && exit 0
	[ -e "$BOOTDIR/WATCHDOG_TIMEOUT" ] && exit 0
	[ "$(cut -d. -f1 /proc/uptime)" -ge "$LIMIT" ] && break
	olpc_sleep 5
done
if [ ! -e "$BOOTDIR/REACHED_USERSPACE_OK" ]; then
	tl "WATCHDOG_TIMEOUT: no REACHED_USERSPACE_OK after ${WAIT}s of userland"
	W=$STAGE/watchdog
	mkdir -p "$W"
	echo "watchdog fired at uptime $(olpc_uptime) (limit $LIMIT)" >"$W/WATCHDOG_TIMEOUT"
	bounded 10 ps >"$W/watchdog-ps.txt" 2>&1
	bounded 10 rc-status -a >"$W/watchdog-rc-status.txt" 2>&1
	bounded 10 dmesg >"$W/watchdog-dmesg.txt" 2>&1
	bounded 10 cat /proc/meminfo /proc/loadavg >"$W/watchdog-meminfo.txt" 2>&1
	olpc_publish "$W" "$BOOTDIR"
	olpc_sync
fi
exit 0
