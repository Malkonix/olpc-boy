#!/bin/sh
# Last step of the default runlevel: mark the boot as complete, flush, then
# start the hardware inventory in the background at the lowest priority so it
# cannot delay anything (it runs after REACHED_USERSPACE_OK by design).
. /usr/libexec/olpcboy/common.sh
echo "$(olpc_uptime)" >"$BOOTDIR/REACHED_USERSPACE_OK"
tl "REACHED_USERSPACE_OK"
olpc_sync
setsid nice -n 19 /usr/local/sbin/olpc-inventory </dev/null >/dev/null 2>&1 &
exit 0
