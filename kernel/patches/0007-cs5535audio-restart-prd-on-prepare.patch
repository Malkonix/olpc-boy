From: olpc-boy
Subject: ALSA: cs5535audio: restart the bus master at the first descriptor on prepare

The bus master advances ACC_BMx_PRD while it walks the descriptor list (the
suspend code saves it with read_prd for that reason), and hw_params programs
it only once, with the address of the closing JMP descriptor.  After an
XRUN ALSA stops the stream (TRIGGER_STOP writes 0 to ACC_BMx_CMD) and
userspace recovers with PREPARE + START on the same hw_params, so the engine
resumed at the descriptor it had reached, while hw_ptr starts again at 0.
Whenever that descriptor lies beyond what was written, the first pointer
reads put hw_ptr past appl_ptr, avail reaches stop_threshold and the stream
underruns again at once.  Each retry moves the engine on by about one
period, so the series of back-to-back underruns lasts until the position
wraps: on the XO-1 about buffer/period events (21 at 128 frames, 12 at 256,
5 at 528, 4 at 1024 out of a 4096-frame buffer) after a single real stall.

Point the engine back at the JMP descriptor from prepare, with the bus master
disabled, and read the status register to acknowledge a pending EOP or
EOP-error flag (the CS5535 pauses the bus master when a second EOP arrives
before the first one is read).  A close/reopen reached the same state
through hw_params, which is why reopening also recovers.

--- a/sound/pci/cs5535audio/cs5535audio_pcm.c
+++ b/sound/pci/cs5535audio/cs5535audio_pcm.c
@@ -267,12 +267,43 @@
 	return 0;
 }
 
+/*
+ * Restart the bus master from the first descriptor.  ACC_BM0_PRD / ACC_BM1_PRD is not a
+ * fixed table base: the engine advances it as it walks the list (the suspend code saves it
+ * with read_prd for that reason).  hw_params programs it once, with the address of the
+ * closing JMP descriptor, but an XRUN stops the stream with TRIGGER_STOP and the next
+ * PREPARE/START reuses the same hw_params, so the engine would resume at whatever descriptor
+ * it had reached while the ALSA pointers start again at 0: the first pointer reads then lie
+ * somewhere in the ring and the stream underruns again at once, one period further on each
+ * time, until the position happens to wrap below what was written.  Point the engine back at
+ * the JMP descriptor and acknowledge any pending EOP / EOP-error flag (a second EOP before
+ * the first was read pauses the bus master) while it is stopped.
+ */
+static void cs5535audio_restart_prd(struct cs5535audio *cs5535au,
+				    struct cs5535audio_dma *dma)
+{
+	unsigned long flags;
+	u32 jmpprd_addr;
+
+	if (!dma->desc_buf.area || !dma->periods)
+		return;
+	jmpprd_addr = (u32)dma->desc_buf.addr +
+		sizeof(struct cs5535audio_dma_desc) * dma->periods;
+	spin_lock_irqsave(&cs5535au->reg_lock, flags);
+	dma->ops->disable_dma(cs5535au);
+	dma->ops->setup_prd(cs5535au, jmpprd_addr);
+	cs_readb(cs5535au, dma->ops->type == CS5535AUDIO_DMA_PLAYBACK ?
+		 ACC_BM0_STATUS : ACC_BM1_STATUS);
+	spin_unlock_irqrestore(&cs5535au->reg_lock, flags);
+}
+
 static int snd_cs5535audio_playback_prepare(struct snd_pcm_substream *substream)
 {
 	struct cs5535audio *cs5535au = snd_pcm_substream_chip(substream);
 	struct cs5535audio_dma *dma = substream->runtime->private_data;
 
 	dma->last_pos = 0;
+	cs5535audio_restart_prd(cs5535au, dma);
 	return snd_ac97_set_rate(cs5535au->ac97, AC97_PCM_FRONT_DAC_RATE,
 				 substream->runtime->rate);
 }
@@ -392,6 +423,7 @@
 	struct cs5535audio_dma *dma = substream->runtime->private_data;
 
 	dma->last_pos = 0;
+	cs5535audio_restart_prd(cs5535au, dma);
 	return snd_ac97_set_rate(cs5535au->ac97, AC97_PCM_LR_ADC_RATE,
 				 substream->runtime->rate);
 }
