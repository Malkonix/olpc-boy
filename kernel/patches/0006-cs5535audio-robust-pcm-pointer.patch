From: olpc-boy
Subject: ALSA: cs5535audio: make the PCM pointer robust against stale reads

snd_cs5535audio_pcm_pointer() read the bus master pointer register once
and returned 0 when it was outside the buffer.  The core calls .pointer
from process context (writes, SNDRV_PCM_IOCTL_DELAY/STATUS) as well as
from the period interrupt, and with 128-frame periods that is many reads
per PRD boundary.  A read that comes back slightly earlier than the
previous one is taken by snd_pcm_update_hw_ptr0() for a wrap of the ring
buffer: it adds a whole buffer to hw_ptr, avail reaches stop_threshold and
the stream is stopped with an XRUN although the buffer is full.  On the
XO-1 this showed as about 1.7 underruns per second (and a sound hitch
each) at a 3.9 ms period, with no frame anywhere near draining the buffer.
Returning 0 for an out-of-range value has the same effect.

Read the register until two consecutive reads agree (at most five
retries, like intel8x0), keep the last good position in the dma and
return it instead of 0 when the value is outside the buffer or went back
by less than a period (at most a quarter of the buffer).  The reported
position is frame aligned.  The position is reset on prepare and on
start/resume, since the engine may restart anywhere.

--- a/sound/pci/cs5535audio/cs5535audio.h
+++ b/sound/pci/cs5535audio/cs5535audio.h
@@ -78,6 +78,7 @@
 	struct snd_pcm_substream *substream;
 	unsigned int buf_addr, buf_bytes;
 	unsigned int period_bytes, periods;
+	unsigned int last_pos;	/* last good pointer, bytes from buf_addr */
 	u32 saved_prd;
 	int pcm_open_flag;
 };
--- a/sound/pci/cs5535audio/cs5535audio_pcm.c
+++ b/sound/pci/cs5535audio/cs5535audio_pcm.c
@@ -270,6 +270,9 @@
 static int snd_cs5535audio_playback_prepare(struct snd_pcm_substream *substream)
 {
 	struct cs5535audio *cs5535au = snd_pcm_substream_chip(substream);
+	struct cs5535audio_dma *dma = substream->runtime->private_data;
+
+	dma->last_pos = 0;
 	return snd_ac97_set_rate(cs5535au->ac97, AC97_PCM_FRONT_DAC_RATE,
 				 substream->runtime->rate);
 }
@@ -289,9 +292,11 @@
 		dma->ops->enable_dma(cs5535au);
 		break;
 	case SNDRV_PCM_TRIGGER_START:
+		dma->last_pos = 0;
 		dma->ops->enable_dma(cs5535au);
 		break;
 	case SNDRV_PCM_TRIGGER_RESUME:
+		dma->last_pos = 0;
 		dma->ops->enable_dma(cs5535au);
 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
@@ -313,23 +318,46 @@
 							*substream)
 {
 	struct cs5535audio *cs5535au = snd_pcm_substream_chip(substream);
-	u32 curdma;
-	struct cs5535audio_dma *dma;
-
-	dma = substream->runtime->private_data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct cs5535audio_dma *dma = runtime->private_data;
+	u32 curdma, prev;
+	unsigned int pos, tries = 5, slack;
+
+	/*
+	 * The bus master moves the pointer while it is read, and a value
+	 * taken around a PRD boundary can be stale.  Trust it only once two
+	 * reads in a row agree (the same retry as intel8x0 and via82xx).
+	 */
 	curdma = dma->ops->read_dma_pntr(cs5535au);
-	if (curdma < dma->buf_addr) {
-		dev_err(cs5535au->card->dev, "curdma=%x < %x bufaddr.\n",
-					curdma, dma->buf_addr);
-		return 0;
+	do {
+		prev = curdma;
+		curdma = dma->ops->read_dma_pntr(cs5535au);
+	} while (curdma != prev && --tries);
+
+	pos = curdma - dma->buf_addr;
+	if (curdma < dma->buf_addr || pos >= dma->buf_bytes) {
+		dev_err_ratelimited(cs5535au->card->dev,
+				    "bad pointer %x (buffer %x+%x)\n",
+				    curdma, dma->buf_addr, dma->buf_bytes);
+		return bytes_to_frames(runtime, dma->last_pos);
 	}
-	curdma -= dma->buf_addr;
-	if (curdma >= dma->buf_bytes) {
-		dev_err(cs5535au->card->dev, "diff=%x >= %x buf_bytes.\n",
-					curdma, dma->buf_bytes);
-		return 0;
+	pos -= pos % frames_to_bytes(runtime, 1);
+
+	/*
+	 * A real wrap of the ring goes back by almost the whole buffer.  A
+	 * small step back is a stale read; reporting it would make
+	 * snd_pcm_update_hw_ptr0() add a whole buffer to hw_ptr and stop the
+	 * stream with an XRUN.
+	 */
+	slack = min(dma->period_bytes, dma->buf_bytes / 4);
+	if (pos < dma->last_pos && dma->last_pos - pos < slack) {
+		dev_warn_ratelimited(cs5535au->card->dev,
+				     "pointer went back: %x -> %x\n",
+				     dma->last_pos, pos);
+		return bytes_to_frames(runtime, dma->last_pos);
 	}
-	return bytes_to_frames(substream->runtime, curdma);
+	dma->last_pos = pos;
+	return bytes_to_frames(runtime, pos);
 }
 
 static int snd_cs5535audio_capture_open(struct snd_pcm_substream *substream)
@@ -361,6 +389,9 @@
 static int snd_cs5535audio_capture_prepare(struct snd_pcm_substream *substream)
 {
 	struct cs5535audio *cs5535au = snd_pcm_substream_chip(substream);
+	struct cs5535audio_dma *dma = substream->runtime->private_data;
+
+	dma->last_pos = 0;
 	return snd_ac97_set_rate(cs5535au->ac97, AC97_PCM_LR_ADC_RATE,
 				 substream->runtime->rate);
 }
