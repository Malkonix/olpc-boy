From: olpc-boy
Subject: staging: olpc_dcon: make XO-1 DCON buildable and probe-able on 6.1

- Drop "depends on BROKEN" (set in 5.19 only because num_registered_fb was to
  become private to fbmem.c; still public in 6.1, so the driver builds).
- Fix the GPIO_CS5535 && ACPI dependency (XO-1 has no ACPI; XO-1.5 has no
  CS5535 GPIO): GPIO_CS5535 || ACPI.
- Make it bool (registered_fb is no longer exported to modules; see 0002).
- Register a gpiod lookup table for the CS5535 chip; without it all
  devm_gpiod_get() calls fail with -ENOENT. The table's dev_id is the I2C
  client name ("0-000d"): gpiolib matches a NULL dev_id only against a NULL
  consumer device. A missing chip yields -EPROBE_DEFER (retry), not an error.

--- a/drivers/staging/olpc_dcon/Kconfig
+++ b/drivers/staging/olpc_dcon/Kconfig
@@ -1,9 +1,9 @@
 # SPDX-License-Identifier: GPL-2.0
 config FB_OLPC_DCON
-	tristate "One Laptop Per Child Display CONtroller support"
+	bool "One Laptop Per Child Display CONtroller support"
-	depends on OLPC && FB && BROKEN
+	depends on OLPC && FB
 	depends on I2C
-	depends on GPIO_CS5535 && ACPI
+	depends on GPIO_CS5535 || ACPI
 	select BACKLIGHT_CLASS_DEVICE
 	help
 	  In order to support very low power operation, the XO laptop uses a
--- a/drivers/staging/olpc_dcon/olpc_dcon_xo_1.c
+++ b/drivers/staging/olpc_dcon/olpc_dcon_xo_1.c
@@ -10,6 +10,8 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+/* machine.h must precede cs5535.h: the latter #defines GPIO_PULL_UP, an enum there */
+#include <linux/gpio/machine.h>
 #include <linux/cs5535.h>
 #include <linux/gpio/consumer.h>
 #include <linux/delay.h>
@@ -26,6 +28,36 @@
 	OLPC_DCON_BLANK,
 };
 
+/*
+ * The descriptor conversion of this driver never added a lookup table for
+ * the CS5535 GPIO chip, so every devm_gpiod_get() below failed with -ENOENT
+ * and the XO-1 probe aborted. Names match gpios_asis[]; line numbers are
+ * OLPC_GPIO_DCON_* from asm/olpc.h. Active-high, like the old integer API.
+ *
+ * gpiolib matches a table to its consumer by dev_name(), and a NULL dev_id
+ * only matches a NULL consumer device, so dev_id is filled in at init time
+ * from the I2C client name ("<adapter>-000d"). If the chip is not registered
+ * yet, devm_gpiod_get() returns -EPROBE_DEFER and the probe is retried.
+ */
+static char gpios_table_dev_id[20];
+static bool gpios_table_added;
+static struct gpiod_lookup_table gpios_table_xo_1 = {
+	.dev_id = gpios_table_dev_id,
+	.table = {
+		GPIO_LOOKUP("cs5535-gpio", OLPC_GPIO_DCON_STAT0, "dcon_stat0",
+			    GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP("cs5535-gpio", OLPC_GPIO_DCON_STAT1, "dcon_stat1",
+			    GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP("cs5535-gpio", OLPC_GPIO_DCON_IRQ, "dcon_irq",
+			    GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP("cs5535-gpio", OLPC_GPIO_DCON_LOAD, "dcon_load",
+			    GPIO_ACTIVE_HIGH),
+		GPIO_LOOKUP("cs5535-gpio", OLPC_GPIO_DCON_BLANK, "dcon_blank",
+			    GPIO_ACTIVE_HIGH),
+		{ },
+	},
+};
+
 static const struct dcon_gpio gpios_asis[] = {
 	[OLPC_DCON_STAT0] = { .name = "dcon_stat0", .flags = GPIOD_ASIS },
 	[OLPC_DCON_STAT1] = { .name = "dcon_stat1", .flags = GPIOD_ASIS },
@@ -42,13 +74,24 @@
 	int ret, i;
 	const struct dcon_gpio *pin = &gpios_asis[0];
 
+	if (!gpios_table_added) {
+		strscpy(gpios_table_dev_id, dev_name(&dcon->client->dev),
+			sizeof(gpios_table_dev_id));
+		gpiod_add_lookup_table(&gpios_table_xo_1);
+		gpios_table_added = true;
+	}
+
 	for (i = 0; i < ARRAY_SIZE(gpios_asis); i++) {
 		gpios[i] = devm_gpiod_get(&dcon->client->dev, pin[i].name,
 					  pin[i].flags);
 		if (IS_ERR(gpios[i])) {
 			ret = PTR_ERR(gpios[i]);
-			pr_err("failed to request %s GPIO: %d\n", pin[i].name,
-			       ret);
+			if (ret != -EPROBE_DEFER)
+				pr_err("failed to request %s GPIO: %d\n",
+				       pin[i].name, ret);
+			/* the table is re-added with the client name on retry */
+			gpiod_remove_lookup_table(&gpios_table_xo_1);
+			gpios_table_added = false;
 			return ret;
 		}
 	}
